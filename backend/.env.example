# Copy to .env and fill in, or run `python scripts/create_local_db.py`, which writes .env for you.
# Local: Postgres 17 in Docker (container postgres17, port 5432).
# Vercel: set DATABASE_URL to the Neon connection string (postgresql://... is accepted as is).
DATABASE_URL=postgresql+psycopg://iseed:change-me@localhost:5432/iseed
# A separate database that pytest wipes and rebuilds. Never point it at real data.
TEST_DATABASE_URL=postgresql+psycopg://iseed:change-me@localhost:5432/iseed_test
# true = print every SQL statement (handy when learning / debugging)
SQL_ECHO=false
